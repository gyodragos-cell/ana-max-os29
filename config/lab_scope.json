{
  "schema_version": "os29.scope.v1",
  "mode": "local",
  "default_action": "deny",
  "approved_hosts": [
    "127.0.0.1",
    "localhost",
    "::1"
  ],
  "approved_networks": [
    "127.0.0.1/32",
    "::1/128"
  ],
  "approved_ports": [7777],
